# Copie para .env. Este arquivo não contém segredos.
# Ano padrão quando --ano não é informado. Outro ano não exige editar código:
#   uv run python -m eleicoes download --ano 2024
ANO_ELEICAO=2022

# Opcional. Pasta de destino. Sem esta variável, os arquivos vão para downloads/{ano}/.
# DIRETORIO_SAIDA=downloads/2022

# Opcional. Diretório CDN do pacote clássico de totalização.
# Sem esta variável, o diretório é derivado do ano:
# https://cdn.tse.jus.br/estatistica/sead/eleicoes/eleicoes{ano}/arqurnatot
# TSE_URL=

# Opcional. Um único conjunto do dados abertos (URL da página ou id do pacote CKAN).
# Quando definido, somente os zips desse conjunto são baixados.
# TSE_DATASET_URL=
