# Copie para .env. Este arquivo não contém segredos.
# Ano padrão quando --ano não é informado. Outro ano não exige editar código:
#   uv run python -m eleicoes download --ano 2024
ANO_ELEICAO=2022

# Opcional. Pasta de destino. Sem esta variável, os arquivos vão para downloads/{ano}/.
# DIRETORIO_SAIDA=downloads/2022

# Opcional. Diretório CDN do pacote clássico de totalização.
# Sem esta variável, o diretório é derivado do ano:
# https://cdn.tse.jus.br/estatistica/sead/eleicoes/eleicoes{ano}/arqurnatot
# TSE_URL=

# Opcional. Um único conjunto do dados abertos (URL da página ou id do pacote CKAN).
# Quando definido, somente os zips desse conjunto são baixados.
# TSE_DATASET_URL=

# Banco relacional da eleição. Postgres e importador leem estas variáveis.
# Placeholders só de desenvolvimento local.
POSTGRES_USER=eleicoes
POSTGRES_PASSWORD=eleicoes
POSTGRES_DB=eleicoes
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Metadados do Metabase ficam no banco metabase, separado dos dados da eleição.
# Usuário e senha são os mesmos do Postgres.
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=eleicoes
MB_DB_PASS=eleicoes

# Heap proporcional ao limite de 1G do contêiner.
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=20.0

# Portas no host, com o prefixo 2 para não colidir com outros projetos.
# Na rede interna o Postgres segue em 5432, o Metabase em 3000 e o Adminer em 8080.
POSTGRES_PUBLISH_PORT=25432
METABASE_PORT=23000
ADMINER_PORT=28080

# Servidor já preenchido no Adminer (nome do serviço na rede interna).
ADMINER_DEFAULT_SERVER=postgres
